# Backend WebSocket base. Each tile connects to
# $NEXT_PUBLIC_WS_BASE/ws/tracks/<camera_id>.
#
#   real backend (FastAPI):    ws://localhost:8000
#   local mock (npm run mock): ws://localhost:8787
NEXT_PUBLIC_WS_BASE=ws://localhost:8787

# Backend HTTP base, used for the fence API
# ($NEXT_PUBLIC_API_BASE/api/fences/<camera_id>).
#
#   real backend (FastAPI):    http://localhost:8000
#   local mock (npm run mock): http://localhost:8787
NEXT_PUBLIC_API_BASE=http://localhost:8787
